%%{init: {"flowchart": {"nodeSpacing": 45, "rankSpacing": 60, "curve": "basis", "wrappingWidth": 460}, "themeVariables": {"fontSize": "16px"}}}%%
%% Munder Difflin multi-agent architecture (smolagents, 4 agents).
%% Numbers on the arrows give the order of delegation; each arrow carries "request / result".
%% Tool boxes list each tool and the starter helpers it uses. Thick arrows are database writes.
%% Dotted orange arrows show REQUEST_CONTEXT, the per-request state the tools share.
flowchart TB
    CUST(["<b>Customer</b><br/>quote request text + date of request"])

    subgraph MAS["Munder Difflin Multi-Agent System (smolagents, 4 agents)"]
        direction TB
        ORCH["<b>Orchestrator Agent</b> (gpt-4o)<br/>ToolCallingAgent with managed_agents<br/>one agent per step (no parallel tool calls)<br/>delegate in order: Inventory, Quoting, Sales<br/>skip Quoting + Sales only if no item is available<br/>final answer checks: available items must be sold first,<br/>reply gives the sale's delivery date + pack conversions<br/>write the customer reply (no internal data)"]
        INV["<b>Inventory Agent</b> (gpt-4o-mini)<br/>send every requested item with qty + unit to check_inventory once<br/>report each row as available, not carried, needs clarification,<br/>or insufficient stock, with its note and ready date"]
        QUO["<b>Quoting Agent</b> (gpt-4o-mini)<br/>price the available items with calculate_quote<br/>explain the price using similar past quotes"]
        SAL["<b>Sales Agent</b> (gpt-4o-mini)<br/>re-verify stock, record the order with fulfill_order<br/>report its delivery date (from the inventory check)"]

        ORCH <-- "<b>1</b> items as written, qty, dates<br/>/ status per item" --> INV
        ORCH <-- "<b>2</b> available items, context<br/>/ quote + discount" --> QUO
        ORCH <-- "<b>3</b> accepted quote<br/>/ sale confirmation" --> SAL
    end

    CUST <-- "request + date<br/>/ quote, delivery date,<br/>items not fulfilled + why" --> ORCH

    INVT["<b>Inventory tools</b><br/>check_inventory, per item:<br/>find_catalog_items &rarr; paper_supplies (size + finish must match),<br/>packs to catalog units (1 ream = 500 sheets)<br/>stock &rarr; get_stock_level()<br/>restock_item &rarr; get_supplier_delivery_date(),<br/>get_cash_balance(), create_transaction('stock_orders')<br/>get_all_inventory()"]
    QUOT["<b>Quoting tools</b><br/>calculate_quote &rarr; paper_supplies prices + bulk discount tiers<br/>search_quote_history()"]
    SALT["<b>Sales tools</b><br/>check_stock_level &rarr; get_stock_level()<br/>fulfill_order &rarr; same pricing as calculate_quote,<br/>create_transaction('sales'), ready dates as delivery date<br/>generate_financial_report()"]

    INV --- INVT
    QUO --- QUOT
    SAL --- SALT

    CTX[("<b>REQUEST_CONTEXT</b><br/>set by handle_request for one request<br/>request + needed-by dates, inventory rows<br/>(catalog qty, ready dates), recorded sale")]

    INVT -. "inventory rows" .-> CTX
    CTX -. "available items + qty" .-> QUOT
    CTX -. "request date, items, qty, ready dates" .-> SALT

    subgraph DATA["Data sources"]
        direction LR
        %% Declared in this order so the layout keeps Inventory, Quoting, Sales left to right.
        SUP[/"<b>Supplier</b> (simulated)<br/>lead time grows with quantity"/]
        DB[("<b>SQLite: munder_difflin.db</b><br/>transactions, inventory,<br/>quotes, quote_requests")]
        CAT[["<b>Product catalog</b><br/>paper_supplies<br/>exact names + unit prices"]]
    end

    INVT -- "names" --> CAT
    INVT -- "read stock, cash, min level" --> DB
    INVT == "write stock_orders" ==> DB
    INVT -- "restock ETA" --> SUP
    QUOT -- "unit prices" --> CAT
    QUOT -- "read past quotes" --> DB
    SALT == "write sales" ==> DB
    SALT -- "read stock, report" --> DB

    classDef customer fill:#FFF4E5,stroke:#C76B00,stroke-width:2px,color:#3D2200
    classDef orchestrator fill:#E8EEFF,stroke:#2F4FD0,stroke-width:2px,color:#0F1B4D
    classDef worker fill:#EAF7EE,stroke:#22874A,stroke-width:2px,color:#0B3319
    classDef tool fill:#FFFFFF,stroke:#8A8F98,stroke-width:1px,color:#1F2328
    classDef data fill:#F3EEFF,stroke:#6B46C1,stroke-width:2px,color:#24124F
    classDef context fill:#FFF8DB,stroke:#B08800,stroke-width:2px,color:#3D2E00

    class CUST customer
    class ORCH orchestrator
    class INV,QUO,SAL worker
    class INVT,QUOT,SALT tool
    class CAT,DB,SUP data
    class CTX context

    linkStyle 4,5,6 stroke:#8A8F98,stroke-dasharray:4 3
    linkStyle 7,8,9 stroke:#B08800,stroke-width:2px,stroke-dasharray:6 4
    linkStyle 12,16 stroke:#C23B3B,stroke-width:3px
